# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Genera secretos con: openssl rand -base64 48

# PostgreSQL local (docker compose)
POSTGRES_PASSWORD=

# Firma de JWT (HS256): 32 bytes aleatorios o más. Sin este valor la app no arranca.
JWT_SECRET=

# Usuarios de demostración (dominio reservado .test). Contraseña: 12+ caracteres con mayúscula, minúscula, número y símbolo.
SEED_ADMIN_EMAIL=admin@vulnmanager.test
SEED_ADMIN_PASSWORD=
SEED_ANALYST_EMAIL=analyst@vulnmanager.test
SEED_ANALYST_PASSWORD=
SEED_VIEWER_EMAIL=viewer@vulnmanager.test
SEED_VIEWER_PASSWORD=

# Token para el cron de GitHub Actions (POST /api/sync/trigger). Vacío = endpoint deshabilitado.
SYNC_TRIGGER_TOKEN=

# Opcional: clave gratuita de NVD (sube el límite de 5 a 50 peticiones por 30 s).
NVD_API_KEY=

# Opcional: webhook HTTPS para alertas (Slack/Discord/Teams). Render bloquea SMTP.
ALERT_WEBHOOK_URL=

# Opcional: orígenes permitidos para CORS, separados por coma (vacío = sin CORS).
CORS_ALLOWED_ORIGINS=
